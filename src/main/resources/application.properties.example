# AWS 환경 설정 예시 (실제 값은 application.properties에 로컬로만 작성하세요)

# 1. Spring Boot 애플리케이션 이름
spring.application.name=HummingService

# 2. AWS RDS 데이터베이스 연결 정보
spring.datasource.url=jdbc:mysql://<RDS_ENDPOINT>:3306/humming?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# 2.1. JPA/Hibernate 설정
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# 3. JWT 설정
jwt.secret=<JWT_SECRET_BASE64>
jwt.access-token-expiration-in-milliseconds=1800000
jwt.refresh-token-expiration-in-milliseconds=604800000

# 4. AI 서버 URL (Hugging Face Space 등)
ai.base-url=<AI_SERVER_URL>

# 5. AWS S3 설정 (IAM Role 기반)
spring.cloud.aws.region.static=ap-northeast-2
spring.cloud.aws.region.auto=false
spring.cloud.aws.stack.auto=false
spring.cloud.aws.s3.bucket=<S3_BUCKET_NAME>

# 6. 로깅 설정
logging.level.com.capstone.HummingService=INFO
logging.level.org.hibernate.SQL=INFO
logging.level.org.springframework.security: INFO
logging.level.org.springframework.security.web: INFO

# 7. 콜백 서버 설정 (AiClientHttp에서 사용)
server.callback-host=<CALLBACK_HOST_IP>
server.port=8080
